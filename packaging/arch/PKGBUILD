# Maintainer: veilzon <veilzon@users.noreply.github.com>
pkgname=animecix
pkgver=1.2.1
pkgrel=1
pkgdesc="Türkçe anime izleme uygulaması (GTK4/libadwaita + mpv)"
arch=('x86_64')
url="https://github.com/veilzon/animecix-linux"
license=('MIT')
depends=('gtk4' 'libadwaita' 'mpv' 'aria2')
makedepends=('rust' 'cargo' 'git')
source=("$pkgname-$pkgver.tar.gz::https://github.com/veilzon/animecix-linux/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # TODO: v1.2.1 release yayınlanınca tarball hash'i yazılacak
options=('!lto')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/animecix" "$pkgdir/usr/bin/animecix"
  install -Dm644 packaging/arch/animecix.desktop "$pkgdir/usr/share/applications/animecix.desktop"
  install -Dm644 packaging/flatpak/io.github.veilzon.AnimeciX.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.veilzon.AnimeciX.metainfo.xml"
  for s in 64 128 256 512; do
    install -Dm644 "assets/icon-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/animecix.png"
  done
  mkdir -p "$pkgdir/usr/share/animecix/assets"
  cp -r assets/upscale "$pkgdir/usr/share/animecix/assets/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
